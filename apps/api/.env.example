# Copy to .env (Bun loads it automatically)
PORT=3000
PUBLIC_URL=http://localhost:3000

# SQLite file (relative to apps/api). Use :memory: for throwaway runs.
DATABASE_PATH=./data/finnova.sqlite

# Secrets — change these for anything beyond local dev
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN_SECONDS=86400
QR_SIGNING_SECRET=dev-qr-secret-change-me
GATEWAY_WEBHOOK_SECRET=dev-gateway-webhook-secret

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Minutes a QR payment request stays valid by default
QR_DEFAULT_TTL_SECONDS=900
