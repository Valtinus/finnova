# Base URL of the FinNova API
VITE_API_URL=http://localhost:3000

# Blockchain page: address of the deployed FinNovaBank contract. `bun run contracts:deploy` writes it
# to .env.local for you; after deploying from Remix, paste it here or under Smart contract → Change.
VITE_CONTRACT_ADDRESS=
# JSON-RPC of the local chain, used to show the linked wallet's balance on the dashboard
VITE_RPC_URL=http://127.0.0.1:8545
